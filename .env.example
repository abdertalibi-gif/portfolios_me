# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin credentials (server-side only, never prefix with VITE_)
# If ADMIN_PASSWORD is omitted, a random password is generated on first start and printed once in the server logs.
ADMIN_EMAIL=admin@talibi.me
ADMIN_PASSWORD=change-me-with-a-strong-password

# Session lifetime in hours
SESSION_TTL_HOURS=8

# Set to true only when served over HTTPS
COOKIE_SECURE=false

# Optional: override the persistent data directory (default: ./data)
# DATA_DIR=./data
