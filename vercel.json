{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist",
  "functions": {
    "server/index.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "server/index.ts"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "server/index.ts"
    }
  ]
}